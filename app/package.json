{
  "name": "@questionable-fyi/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "start": "node bin/server.js",
    "changeset": "pnpm -w changeset",
    "prebuild": "pnpm lex:build",
    "build": "node ace build",
    "dev": "node ace serve --hmr --no-clear",
    "dev:debug": "node ace --inspect-wait=9229 serve --hmr",
    "test": "node ace test",
    "test:unit": "vitest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p inertia/tsconfig.json",
    "lex:build": "pnpm lex build --clear --indexFile --lexicons ../lexicons/src --out ./app/lexicons",
    "lex": "node_modules/.bin/lex",
    "db:migrate": "node ace migration:run"
  },
  "imports": {
    "#generated/*": "./.adonisjs/server/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#dtos/*": "./app/dtos/*.js",
    "#events/*": "./app/events/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#lexicons/*": "./app/lexicons/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#mails/*": "./app/mails/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#models/*": "./app/models/*.js",
    "#policies/*": "./app/policies/*.js",
    "#services/*": "./app/services/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#utils/*": "./app/utils/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/dom-navigation": "^1.0.7",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/lib-dom": "npm:@types/web@^0.0.347",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "yalc": "1.0.0-pre.53",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.0",
    "@atproto-labs/simple-store": "^0.3.0",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/lex": "^0.0.25",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/syntax": "^0.5.4",
    "@atproto/tap": "^0.2.13",
    "@inertiajs/react": "^2.3.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@thisismissem/adonisjs-atproto-oauth": "^3.0.4",
    "@thisismissem/adonisjs-atproto-tap": "^3.1.2",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.0",
    "lucide-react": "^1.11.0",
    "luxon": "^3.7.2",
    "motion": "^12.38.0",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.12.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
