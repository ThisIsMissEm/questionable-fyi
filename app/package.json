{
  "name": "@questionable-fyi/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "start": "node bin/server.js",
    "changeset": "pnpm -w changeset",
    "prebuild": "pnpm lex:build",
    "build": "node ace build",
    "dev": "node ace serve --hmr --no-clear",
    "dev:debug": "node ace --inspect=9229 serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lex:build": "pnpm lex build --clear --indexFile --lexicons ../lexicons --out ./app/lexicons",
    "lex": "node_modules/.bin/lex",
    "db:migrate": "node ace migration:run"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#lexicons/*": "./app/lexicons/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#dtos/*": "./app/dtos/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#utils/*": "./app/utils/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.3",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "yalc": "1.0.0-pre.53",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.1.0",
    "@adonisjs/lucid": "^22.1.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@atproto-labs/simple-store": "^0.3.0",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/lex": "^0.0.20",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/syntax": "^0.5.0",
    "@atproto/tap": "^0.2.8",
    "@inertiajs/react": "^2.3.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@thisismissem/adonisjs-atproto-oauth": "file:.yalc/@thisismissem/adonisjs-atproto-oauth",
    "@thisismissem/adonisjs-atproto-tap": "^3.0.0",
    "@vinejs/vine": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.0",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "motion": "^12.27.0",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
