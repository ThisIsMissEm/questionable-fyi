{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM"],
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./lib/*"],
      "@generated/*": ["../.adonisjs/client/*"],
      "@lexicons/*": ["../app/lexicons/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../.adonisjs/client/**/*.ts",
    "../.adonisjs/server/**/*.ts",
    "../app/lexicons/**/*.ts"
  ]
}
